---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title="商品" description="我做过的副业项目 — 实用工具与数字商品">
  <section class="section" style="padding-top: var(--sp-16);">
    <div class="container container--wide">
      <span class="hero__tag">商品列表</span>
      <h1 style="font-size: var(--fs-3xl); margin-top: var(--sp-3);">所有商品</h1>
      <p class="muted" style="margin-top: var(--sp-4); max-width: 640px;">
        这些都是真实在用、解决过真问题的东西。点击查看详情。
      </p>

      <ul class="row-list" style="margin-top: var(--sp-10);">
        {projects.map((p) => (
          <li class="row-list__item">
            <div>
              <div class="row-list__title">
                <a href={`/projects/${p.slug}/`}>
                  {p.data.icon} {p.data.title}
                </a>
              </div>
              <div class="row-list__desc">{p.data.description}</div>
              <div style="margin-top: var(--sp-3);">
                {p.data.tags.map((t) => <span class="badge">{t}</span>)}
              </div>
            </div>
            <a href={`/projects/${p.slug}/`} class="btn btn--ghost btn--sm" style="white-space: nowrap;">
              查看 →
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
